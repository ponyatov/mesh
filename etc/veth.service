# sudo systemctl daemon-reload
# sudo systemctl enable  veth@dev01
# sudo systemctl disable veth@dev01
# sudo systemctl start   veth@dev01
# sudo systemctl stop    veth@dev01
# sudo systemctl status  veth@dev01

[Unit]
Description = veth @ %I
Wants = network-online.target
After = network.target network-online.target

[Service]
Type = oneshot
RemainAfterExit=yes
WorkingDirectory = /home/%i/veth
User  = root
Group = root
ExecStart = /bin/sh etc/veth.start
ExecStop  = /bin/sh etc/veth.stop

[Install]
WantedBy=multi-user.target
